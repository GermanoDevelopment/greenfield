# Environment & Server
ENVIRONMENT=development
PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://greenfield:greenfield@localhost:5432/greenfield

# JWT Authentication
JWT_SECRET=supersecretjwtkey_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# GitHub OAuth & Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Developer & Admin Flags
ENABLE_DEV_LOGIN=false
ADMIN_GITHUB_USERNAMES=["GermanoDevelopment"]

# Solana Devnet & Smart Contract
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_TREASURY_KEYPAIR_PATH=
SOLANA_TREASURY_PRIVATE_KEY=
SOLANA_AUTHORITY_SECRET_KEY=

# Rate Limiting & Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_GITHUB_PER_MINUTE=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
