# ==============================================================================
# Greenfield Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development

# Database (PostgreSQL)
POSTGRES_USER=greenfield
POSTGRES_PASSWORD=greenfield
POSTGRES_DB=greenfield
POSTGRES_PORT=5433

# Backend API
BACKEND_PORT=8080
JWT_SECRET=supersecretjwtkey_change_in_production
JWT_EXPIRATION_MINUTES=1440
ENABLE_DEV_LOGIN=true
FRONTEND_URL=http://localhost:3000

# GitHub OAuth (Optional for local development if ENABLE_DEV_LOGIN=true)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
GITHUB_WEBHOOK_SECRET=

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CHAIN=solana:devnet
SOLANA_PROGRAM_ID=

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=/api/v1
